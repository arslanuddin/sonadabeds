@model IEnumerable<Product>
@{ViewData["Title"]="Luxury Beds, Made for You";}
<section class="hero"><div><p class="eyebrow">SONADA · MADE TO ORDER</p><h1>Luxury beds.<br><em>Built around you.</em></h1><p>Beautifully upholstered beds, premium mattresses and considered storage, crafted for the way you live.</p><a class="button" asp-controller="Products" asp-action="Index">Explore the collection</a></div><div class="hero-art"><div class="bed-shape"></div></div></section>
<section class="intro"><p class="eyebrow">THE SONADA STANDARD</p><h2>Quiet luxury, without compromise.</h2><p>Choose your silhouette, size, fabric and finishing details. Every piece is made to order and checked by hand before it leaves our workshop.</p></section>
<section class="products"><div class="section-head"><h2>Featured designs</h2><a asp-controller="Products" asp-action="Index">View all</a></div><div class="grid">@foreach(var p in Model){<article class="card"><a asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug"><img src="@p.ImageUrl" alt="@p.Name"><div><p class="eyebrow">@p.Category?.Name</p><h3>@p.Name</h3><p>From <strong>£@p.BasePrice.ToString("N0")</strong></p></div></a></article>}</div></section>
<section class="banner"><div><p class="eyebrow">A SMALL DETAIL, A BIG DIFFERENCE</p><h2>See the fabrics in your own space.</h2><p>Order complimentary upholstery swatches before choosing your finish.</p><a class="button light" asp-controller="Marketing" asp-action="Swatches">Request swatches</a></div></section>
