@model IEnumerable<SonadaBeds.Web.Models.CartItem>
@{ViewData["Title"]="Your Bag";var total=Model.Sum(x=>x.UnitPrice*x.Quantity);}
<section class="page-head"><p class="eyebrow">YOUR ORDER</p><h1>Your bag</h1></section><section class="cart">@if(!Model.Any()){<p>Your bag is currently empty.</p><a class="button" asp-controller="Products" asp-action="Index">Continue shopping</a>}else{foreach(var item in Model){<div class="cart-row"><div><h3>@item.ProductName</h3><p>Qty @item.Quantity · £@item.UnitPrice.ToString("N2") each</p></div><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@item.ProductId"><button class="text-button">Remove</button>@Html.AntiForgeryToken()</form></div>}<div class="cart-total"><span>Subtotal</span><strong>£@total.ToString("N2")</strong></div><a class="button" asp-controller="Checkout" asp-action="Index">Checkout</a>}</section>
