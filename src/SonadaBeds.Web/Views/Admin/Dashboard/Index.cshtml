@{ViewData["Title"]="Admin Dashboard";}<section class="page-head"><p class="eyebrow">SONADA ADMIN</p><h1>Store overview</h1></section><div class="stats"><div><span>Products</span><strong>@ViewBag.Products</strong></div><div><span>Orders</span><strong>@ViewBag.Orders</strong></div><div><span>Customers</span><strong>@ViewBag.Customers</strong></div><div><span>Revenue</span><strong>£@((decimal)ViewBag.Revenue).ToString("N0")</strong></div></div><p class="notice">The admin area is role protected. Extend this area with CRUD screens for catalogue, orders, customers, coupons, content, swatches and postcode delivery rules.</p>
