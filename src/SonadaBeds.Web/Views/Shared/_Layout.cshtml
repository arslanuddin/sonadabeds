<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · Sonada Beds</title><meta name="description" content="Made-to-order luxury beds, mattresses and upholstered furniture from Sonada Beds."><link rel="canonical" href="https://sonadabeds.co.uk@Context.Request.Path"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head><body><header class="nav"><a class="brand" asp-controller="Home" asp-action="Index">SONADA <span>BEDS</span></a><nav><a asp-controller="Products" asp-action="Index">Beds & Mattresses</a><a href="/products?category=beds">Beds</a><a href="/products?category=mattresses">Mattresses</a><a asp-controller="Marketing" asp-action="Swatches">Free Swatches</a><a asp-controller="Cart" asp-action="Index">Bag</a></nav></header><main>@RenderBody()</main><footer><div><strong>SONADA BEDS</strong><p>Thoughtfully designed. Made to order. Built to last.</p></div><div><h4>Customer care</h4><a href="/Home/Privacy">Delivery & Returns</a><a href="/Marketing/Swatches">Order fabric swatches</a></div><div><h4>Stay in touch</h4><form asp-controller="Marketing" asp-action="Newsletter" method="post"><input name="email" type="email" placeholder="Your email" required><button>Subscribe</button>@Html.AntiForgeryToken()</form></div></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
