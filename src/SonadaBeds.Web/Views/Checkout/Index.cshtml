@{ViewData["Title"]="Checkout";}
<section class="page-head"><p class="eyebrow">SECURE CHECKOUT</p><h1>Complete your order</h1></section><section class="checkout"><form asp-action="PlaceOrder" method="post"><label>Email<input name="email" type="email" required autocomplete="email"></label><label>Delivery address<textarea name="shippingAddress" rows="5" required autocomplete="street-address"></textarea></label><p class="notice">Delivery is free on orders of £750 or more; otherwise £49 UK delivery is applied. Payment-provider integration is isolated behind the checkout service and ready for a production gateway.</p><button class="button">Place order</button>@Html.AntiForgeryToken()</form></section>
